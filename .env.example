# Required: API key for the Grok (xAI) API — get one at https://console.x.ai
XAI_API_KEY=

# Optional tuning
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_S=60
GROK_MAX_RETRIES=2
GROK_BACKOFF_S=0.5

# CPU cores the sandbox is provisioned with (target deployment: 8)
SANDBOX_CPUS=8
